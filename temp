#include <stdio.h>
#include <string.h>

char stack[100], input[100];
int top = -1, ip = 0;

char table[4][4] = {
    {'-', '>', '>', '>'},
    {'<', '>', '<', '>'},
    {'<', '>', '>', '>'},
    {'<', '<', '<', '='}
};

char terminals[] = {'i', '+', '*', '$'};

int indexOf(char c)
{
    for (int i = 0; i < 4; i++)
        if (terminals[i] == c)
            return i;
    return -1;
}

char topTerminal()
{
    for (int i = top; i >= 0; i--)
        if (indexOf(stack[i]) != -1)
            return stack[i];
    return '$';
}

void reduce()
{
    if (stack[top] == 'i') {
        stack[top] = 'E';
    }
    else if (top >= 2 &&
             stack[top] == 'E' &&
             (stack[top - 1] == '+' ||
              stack[top - 1] == '*') &&
             stack[top - 2] == 'E') {
        stack[top - 2] = 'E';
        top -= 2;
    }
    else {
        printf("\nString is rejected\n");
        top = -1;
        return;
    }
}

int main()
{
    printf("Enter the input string (append with $): ");
    scanf("%99s", input);

    stack[++top] = '$';

    printf("\n%-15s %-15s %s\n",
           "STACK", "INPUT STRING", "ACTION");

    while (top >= 0) {
        printf("%-15s %-15s ",
               stack, input + ip);

        if (stack[0] == '$' &&
            top == 1 && stack[1] == 'E' &&
            input[ip] == '$') {
            printf("String is accepted\n");
            return 0;
        }

        char a = topTerminal();
        char b = input[ip];

        int row = indexOf(a);
        int col = indexOf(b);

        if (row == -1 || col == -1) {
            printf("String is rejected\n");
            return 0;
        }

        char relation = table[row][col];

        if (relation == '<' || relation == '=') {
            stack[++top] = b;
            stack[top + 1] = '\0';
            ip++;
            printf("Shift\n");
        }
        else if (relation == '>') {
            reduce();
            if (top == -1)
                return 0;
            stack[top + 1] = '\0';
            printf("Reduce\n");
        }
        else {
            printf("String is rejected\n");
            return 0;
        }
    }

    return 0;
}

