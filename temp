#include <stdio.h>
#include <string.h>

int main()
{
    char stack[50] = "$", input[50];
    int top = 0, i = 0;

    printf("SHIFT REDUCE PARSER\n");
    printf("Grammar: E->E+E, E->E/E, E->E*E, E->a|b\n");
    printf("Enter the input string: ");
    scanf("%49s", input);

    strcat(input, "$");

    printf("\n%-15s %-15s %s\n", "Stack", "Input", "Action");

    while (1)
    {
        if (top == 1 && stack[1] == 'E' && input[i] == '$')
        {
            printf("%-15s %-15s ACCEPT\n", stack, input + i);
            break;
        }

        if (stack[top] == 'a' || stack[top] == 'b')
        {
            char c = stack[top];
            stack[top] = 'E';
            stack[top + 1] = '\0';
            printf("%-15s %-15s REDUCE E->%c\n",
                   stack, input + i, c);
        }
        else if (top >= 2 && stack[top] == 'E' &&
                stack[top - 2] == 'E' &&
                (stack[top - 1] == '+' ||
                 stack[top - 1] == '*' ||
                 stack[top - 1] == '/'))
        {
            char op = stack[top - 1];
            top -= 2;
            stack[top] = 'E';
            stack[top + 1] = '\0';
            printf("%-15s %-15s REDUCE E->E%cE\n",
                   stack, input + i, op);
        }
        else if (input[i] != '$')
        {
            stack[++top] = input[i];
            stack[top + 1] = '\0';
            printf("%-15s %-15s SHIFT %c\n",
                   stack, input + i + 1, input[i]);
            i++;
        }
        else
        {
            printf("%-15s %-15s REJECT\n", stack, input + i);
            break;
        }
    }

    return 0;
}

