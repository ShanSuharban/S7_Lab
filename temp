#include <stdio.h>
#include <ctype.h>

char p[10][10];
int n;

void first(char c)
{
    int i;
    for (i = 0; i < n; i++)
        if (p[i][0] == c) {
            char x = p[i][2];
            if (!isupper(x))
                printf("%c ", x);
            else
                first(x);
        }
}

void follow(char c)
{
    int i, j;
    if (p[0][0] == c)
        printf("$ ");

    for (i = 0; i < n; i++)
        for (j = 2; p[i][j]; j++)
            if (p[i][j] == c) {
                char x = p[i][j + 1];
                if (x && !isupper(x))
                    printf("%c ", x);
                else if (x)
                    first(x);
                else if (p[i][0] != c)
                    follow(p[i][0]);
            }
}



int main()
{
    char c;
    int i;

    printf("Enter number of productions: ");
    scanf("%d", &n);

    printf("Enter productions (e.g. S=AB):\n");
    for (i = 0; i < n; i++)
        scanf("%s", p[i]);

    do {
        printf("\nEnter non-terminal (0 to stop): ");
        scanf(" %c", &c);

        if (c == '0')
            break;

        printf("FIRST(%c) = { ", c);
        first(c);
        printf("}\n");

        printf("FOLLOW(%c) = { ", c);
        follow(c);
        printf("}\n");

    } while (1);

    return 0;
}

